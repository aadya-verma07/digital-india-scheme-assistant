# Copy this file to .env and edit.

# --- Database ---
# Leave commented to use a local SQLite file (zero setup, good for demos).
# Uncomment to use PostgreSQL (as in the synopsis):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scheme_assistant

# --- AI assistant ---
# none = answers built from the database only (works offline, no key needed)
# gemini | openai | anthropic = LLM writes the answer from the retrieved scheme records
LLM_PROVIDER=none
LLM_API_KEY=
# Optional: override the default model for the provider
# LLM_MODEL=gemini-2.5-flash
